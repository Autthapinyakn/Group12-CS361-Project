{
  "name": "cs361-group12-api",
  "version": "1.0.0",
  "description": "Curriculum information and graduation verification API (AWS Lambda behind API Gateway HTTP API)",
  "main": "dist/functions/api.js",
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx dev/server.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
