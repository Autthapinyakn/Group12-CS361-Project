    USERS |o--o{ STUDENTS : advises
    CURRICULA ||--o{ STUDENTS : enrolls
    USERS ||--o{ CURRICULUM_EDIT_LOG : makes

    %% ===== V4 (planned): graduation verification =====
    STUDENTS ||--o{ STUDENT_COURSE_STATUS : takes
    COURSES ||--o{ STUDENT_COURSE_STATUS : "taken as"

